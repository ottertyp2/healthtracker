rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function automationSettings(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/settings/automation).data;
    }

    function ownsShortcutToken(token) {
      return signedIn() && automationSettings(request.auth.uid).shortcutToken == token;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if ownsUserDoc(userId);
    }

    match /agentAccess/{token}/snapshots/{snapshotId} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /agentAccess/{token}/meta/{docId} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /agentAccess/{token}/agentRuns/{runId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /shortcutAccess/{token}/healthImports/{importId} {
      allow read, update, delete: if ownsShortcutToken(token);
      allow create: if request.resource.data.keys().hasOnly([
        "date",
        "sleepHours",
        "sleepStart",
        "sleepEnd",
        "weightKg",
        "bodyFatPct",
        "steps",
        "restingHeartRate",
        "source",
        "raw",
        "importedAt",
        "createdAt",
        "updatedAt"
      ]);
    }
  }
}
